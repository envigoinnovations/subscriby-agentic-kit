{
  "description": "Every Subscriby tool that changes or removes existing data asks before it runs, whatever the server's permission setting. The matcher is generated from the tool catalogue by npm run sync and leaves the server part open, so it holds under any name a host gives the server; the answer is hooks/ask-before-destructive.sh.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__(update_team_member_role|update_team|update_role|update_group|sync_group_members|remove_team_member|delete_team|delete_role|delete_group|cancel_team_invitation|archive_project|ban_member|broadcast_message|retry_broadcast|cancel_subscription|complete_creator_task|reactivate_subscription|unpause_subscription|pause_subscription|delete_resource|kick_member|archive_link|update_sequence|delete_sequence|notify_members_of_recovery|remove_resource_standby|remove_standby_installation|revert_recovery_operation|run_connector_installation_action|uninstall_connector|use_resource_standby|publish_plan|reorder_plans|resolve_support_conversation|revoke_token|unban_member|unlink_member_identity|unlink_resource|update_project|publish_portal_design|discard_portal_design_draft|update_support_settings|update_resource|update_plan|update_coupon|update_canned_reply|unblock_support_contact|sync_payment_method_plans|rotate_webhook_endpoint_secret|resume_webhook_endpoint|restore_project|reopen_support_conversation|reissue_subscription_grants|pause_webhook_endpoint|disconnect_connector|delete_webhook_endpoint|delete_project|delete_plan|delete_payment_method|delete_coupon|delete_canned_reply|deactivate_resource|deactivate_payment_method|deactivate_coupon|cancel_pass_window|block_support_contact|assign_support_conversation|activate_resource|activate_payment_method|activate_coupon|update_referral_program|activate_referral_program|deactivate_referral_program|delete_referral_program|approve_referral_affiliate|suspend_referral_affiliate|record_referral_payout|update_partner_payout_details|update_knowledge_entry|delete_knowledge_entry|update_copilot_credits_settings|create_token|update_alert_destinations|revoke_access_code)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ask-before-destructive.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
